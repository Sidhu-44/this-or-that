# ==========================================
# ThisOrThat - Environment Configuration
# ==========================================

# Database Connection (PostgreSQL or SQLite)
# For local SQLite development (default):
DATABASE_URL=sqlite:///./thisorthat.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thisorthat

# Admin API Secret Key (for scheduling and editing polls)
ADMIN_API_KEY=thisorthat-admin-secret-2026

# Application Timezone (strictly Asia/Kolkata for 12:00 AM IST rollover)
APP_TIMEZONE=Asia/Kolkata

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend API URL (for Vite)
VITE_API_URL=http://localhost:8000
